# Copie para .env e preencha. O .env é gitignorado e nunca deve ser commitado.

# development | production
ENVIRONMENT=development

# ─────────────────────────────── Banco
# PostgreSQL com driver asyncpg — repare no "+asyncpg" no esquema.
# No Supabase: Project Settings > Database > Connection string > URI
# (troque "postgresql://" por "postgresql+asyncpg://" na string que ele fornece)
DATABASE_URL=postgresql+asyncpg://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# Ecoa todo SQL no console. Ruidoso — ligue apenas para depurar.
DB_ECHO=false

# ─────────────────────────────── Segurança
# Assina os tokens JWT. Mínimo de 32 caracteres; a aplicação recusa subir sem isso.
# Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# ─────────────────────────────── Multi-tenancy
# Domínio base da resolução de tenant por subdomínio.
# Desenvolvimento: localhost  (acesse como acme.localhost:8000)
# Produção:        pacta.com.br
BASE_DOMAIN=localhost
